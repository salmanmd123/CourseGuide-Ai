
# ==========================================
# CourseGuide AI - Git Ignore
# ==========================================

# Node.js dependencies
/node_modules/

# Next.js generated files
/.next/
/out/

# Production and build output
/build/
/dist/
/coverage/

# Environment variables and secrets
.env
.env.*
!.env.example

# Vercel
.vercel/

# Yarn and package manager
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python virtual environments
/venv/
/.venv/
/language-detector/venv/
/language-detector/.venv/

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Local databases
*.sqlite
*.sqlite3
*.db

# TypeScript generated cache
*.tsbuildinfo

# Logs and debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Editor settings
.vscode/
.idea/

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Temporary files
*.tmp
*.temp
*.bak
